{
  "manifest_version": 3,
  "name": "Unhook Companion",
  "version": "0.1.0",
  "description": "Browser blocking controlled by the Unhook desktop app. No separate settings or account.",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": ["nativeMessaging", "declarativeNetRequest", "tabs", "storage", "alarms", "webNavigation"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Unhook · controlled by the desktop app", "default_popup": "popup.html" },
  "web_accessible_resources": [{ "resources": ["blocked.html", "blocked.css"], "matches": ["http://*/*", "https://*/*"] }],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'" }
}
