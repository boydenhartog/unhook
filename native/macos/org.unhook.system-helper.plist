<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>org.unhook.system-helper</string>
  <key>BundleProgram</key><string>Contents/MacOS/unhook-system-helper</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>Sockets</key><dict><key>Control</key><dict>
    <key>SockPathName</key><string>/var/run/org.unhook.system-helper.sock</string>
    <key>SockPathMode</key><integer>438</integer>
    <key>SockType</key><string>stream</string>
  </dict></dict>
</dict></plist>
