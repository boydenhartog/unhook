{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Unhook",
  "version": "0.2.3",
  "identifier": "org.unhook.desktop",
  "build": {
    "beforeDevCommand": "npm run prepare:browser-host && npm run prepare:system-helper && node scripts/package-extension.mjs && npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run prepare:browser-host && npm run prepare:system-helper && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Unhook",
        "width": 1100,
        "height": 780,
        "minWidth": 760,
        "minHeight": 650
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "externalBin": ["binaries/unhook-browser-host"],
    "resources": { "../dist/unhook-companion/": "browser-extension/" },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "files": {
        "Library/LaunchDaemons/org.unhook.system-helper.plist": "../native/macos/org.unhook.system-helper.plist",
        "MacOS/unhook-system-helper": "binaries/unhook-system-helper"
      }
    },
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "A little distance from distraction.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
